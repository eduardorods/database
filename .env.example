# Copie este arquivo para .env e preencha com suas credenciais do Supabase.
# Nunca versione o arquivo .env real.
#
# Formato esperado (Supabase fornece esta string em:
#   Project Settings → Database → Connection string → URI):
#
DATABASE_URL=postgresql+psycopg2://postgres:<sua-senha>@db.<seu-projeto>.supabase.co:5432/postgres

# Google Drive — Service Account
# Cole aqui o conteúdo completo do JSON baixado do Google Cloud Console
# (IAM & Admin → Service Accounts → Chaves → Adicionar chave → JSON).
# Atenção: mantenha tudo em uma única linha, sem quebras.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# ID da pasta raiz no Google Drive onde ficam as subpastas de cada CRI
# (ex.: https://drive.google.com/drive/folders/<ESTE_ID>)
DRIVE_FOLDER_CRIS_ID=<id-da-pasta-raiz-no-drive>

# Gemini — Google AI Studio
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=<sua-chave-do-google-ai-studio>
